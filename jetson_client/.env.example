# WebSocket URL of the /ws/voice endpoint on the GPU workstation (reachable via Tailscale).
VOICE_WS_URL=ws://100.x.x.x:8000/ws/voice

VOICE_SAMPLE_RATE=16000
VOICE_CHUNK_SIZE=1024

# Tune SILENCE_THRESHOLD to the mic/room -- RMS amplitude of int16 samples,
# not dB. Start around 300-800 and adjust based on ambient noise.
VOICE_SILENCE_THRESHOLD=500
VOICE_SILENCE_DURATION_S=0.8
VOICE_MIN_UTTERANCE_S=0.4
VOICE_MAX_UTTERANCE_S=15.0
