# Service
SERVICE_NAME=ollama-fastapi-robot-proxy

# Ollama endpoints
OLLAMA_LOCAL_BASE_URL=http://localhost:11434
OLLAMA_REMOTE_URLS=http://REMOTE_SERVER_IP:11434

# Routing and fallback
REMOTE_PRIMARY_MODEL=qwen2.5:7b-instruct
LOCAL_FALLBACK_MODEL=qwen2.5:1.5b-instruct

# Optional mode/model routing
CODE_MODEL=deepseek-coder:6.7b
EMBEDDING_MODEL=nomic-embed-text
VISION_MODEL=llava:7b

# Network behavior
REQUEST_TIMEOUT_SECONDS=45
HEALTH_TIMEOUT_SECONDS=3
MAX_RETRIES=1

# RAG behavior
ENABLE_QUERY_REWRITE=true
RAG_DISTANCE_THRESHOLD=0.46
RAG_DENSE_WEIGHT=0.7
RAG_KEYWORD_WEIGHT=0.3
RAG_MIN_FUSION_SCORE=0.05
RAG_CANDIDATE_POOL_MULTIPLIER=4
RAG_CONTEXT_MAX_CHARS=2800
RAG_CONTEXT_MAX_CHUNKS=4
RAG_DEDUPE_SIMILARITY_THRESHOLD=0.92
RAG_LOG_PATH=./logs/rag_events.jsonl
MEMORY_MAX_TURNS=8

# Conditional query rewrite: questions longer than this word count (or matching
# conversational filler) get rewritten into a short search query before embedding.
RAG_REWRITE_WORD_THRESHOLD=8
REWRITE_MAX_TOKENS=32
RAG_ANSWER_MAX_TOKENS=220

# In-process retrieval/embedding caching (no external cache store required)
ENABLE_RAG_CACHE=true
RAG_CACHE_TTL_SECONDS=600
RAG_CACHE_MAX_SIZE=256
EMBEDDING_CACHE_MAX_SIZE=512

# Multimodal knowledge-base ingestion (images + PDF-embedded images via LLaVA)
KB_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp,.bmp
VISION_MAX_IMAGE_BYTES=15000000

# Keep the primary model resident in memory between requests (avoids reload latency)
OLLAMA_KEEP_ALIVE=30m

# Voice pipeline (STT / denoise / TTS) -- server-side, requires requirements-voice.txt
STT_MODEL_SIZE=small
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_LANGUAGE=en

ENABLE_DENOISE=true

TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_SPEAKER=Claribel Dervla
TTS_LANGUAGE=en
TTS_DEVICE=cuda

VOICE_SAMPLE_RATE=16000
VOICE_MAX_AUDIO_SECONDS=20

# Persistent session/utterance storage (PostgreSQL + TimescaleDB). Postgres
# being unreachable must never break a live voice turn -- see app/db/safe_logging.py.
# When running via docker-compose, DATABASE_URL is overridden to point at the
# "db" service automatically; only POSTGRES_* matter there. For a bare
# `uvicorn` run against a local Postgres, set DATABASE_URL directly instead.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/robot_sessions
DATABASE_CONNECT_TIMEOUT_SECONDS=2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=robot_sessions
